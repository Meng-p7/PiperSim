<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="piper_ros2_control" params="
    name
    prefix
    include_gripper:=true
    mock_hardware:=false
    sim_mujoco:=false
    real_hardware:=false
    calibration_mode:=false
    can_interface:=can0
    speed_percent:=20
    feedback_timeout_ms:=250
    max_arm_step:=0.02
    max_gripper_step:=0.002
    mujoco_headless:=false
    joint_state_topic_hardware:=false
    joint_commands_topic:=/joint_commands_topic
    joint_states_topic:=/joint_states_topic
    initial_positions:=${dict(joint1=0.0,joint2=0.0,joint3=0.0,joint4=0.0,joint5=0.0,joint6=0.0)}">

    <ros2_control name="${name}" type="system">
      <hardware>
        <!-- MuJoCo simulation using mujoco_ros2_control -->
        <xacro:if value="${sim_mujoco}">
          <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
          <param name="mujoco_model">$(find piper_mujoco)/models/piper.xml</param>
          <param name="use_sim_time">true</param>
          <param name="headless">${mujoco_headless}</param>
        </xacro:if>
        <!-- This supports Isaac sim and Hardware -->
        <xacro:if value="${joint_state_topic_hardware}">
          <plugin>joint_state_topic_hardware_interface/JointStateTopicSystem</plugin>
          <param name="joint_commands_topic">${joint_commands_topic}</param>
          <param name="joint_states_topic">${joint_states_topic}</param>
        </xacro:if>
        <xacro:if value="${mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="state_following_offset">0.0</param>
        </xacro:if>
        <!-- Real hardware interface -->
        <xacro:if value="${real_hardware}">
          <plugin>piper_control/PiperHardware</plugin>
          <param name="can_interface">${can_interface}</param>
          <param name="calibration_mode">${calibration_mode}</param>
          <param name="speed_percent">${speed_percent}</param>
          <param name="feedback_timeout_ms">${feedback_timeout_ms}</param>
          <param name="max_arm_step">${max_arm_step}</param>
          <param name="max_gripper_step">${max_gripper_step}</param>
        </xacro:if>
      </hardware>

      <joint name="${prefix}joint1">
        <command_interface name="position">
          <param name="min">-2.6179</param>
          <param name="max">2.6179</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint1']}</param>
        </state_interface>
        <xacro:unless value="${real_hardware}">
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </xacro:unless>
      </joint>
      <joint name="${prefix}joint2">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">3.14</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint2']}</param>
        </state_interface>
        <xacro:unless value="${real_hardware}">
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </xacro:unless>
      </joint>
      <joint name="${prefix}joint3">
        <command_interface name="position">
          <param name="min">-2.697</param>
          <param name="max">0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint3']}</param>
        </state_interface>
        <xacro:unless value="${real_hardware}">
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </xacro:unless>
      </joint>
      <joint name="${prefix}joint4">
        <command_interface name="position">
          <param name="min">-1.745</param>
          <param name="max">1.745</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint4']}</param>
        </state_interface>
        <xacro:unless value="${real_hardware}">
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </xacro:unless>
      </joint>
      <joint name="${prefix}joint5">
        <command_interface name="position">
          <param name="min">-1.22</param>
          <param name="max">1.22</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint5']}</param>
        </state_interface>
        <xacro:unless value="${real_hardware}">
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </xacro:unless>
      </joint>
      <joint name="${prefix}joint6">
        <command_interface name="position">
          <param name="min">-2.09439</param>
          <param name="max">2.09439</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint6']}</param>
        </state_interface>
        <xacro:unless value="${real_hardware}">
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </xacro:unless>
      </joint>

      <xacro:if value="${include_gripper}">
        <joint name="${prefix}gripper_joint">
          <command_interface name="position">
            <param name="min">0.0</param>
            <param name="max">0.035</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <xacro:unless value="${real_hardware}">
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
          </xacro:unless>
        </joint>
      </xacro:if>
    </ros2_control>
  </xacro:macro>

</robot>
