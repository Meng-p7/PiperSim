    <origin xyz="0 0 0.123" rpy="0 0 -1.57080057"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.618" upper="2.618" effort="100" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.3"/>
  </joint>

