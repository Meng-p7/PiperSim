      <geometry>
        <box size="0.028 0.034 0.024"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.15 0.15 0.15 1"/>
      </material>
    </visual>
  </link>

  <joint name="wrist_cam_joint" type="fixed">
