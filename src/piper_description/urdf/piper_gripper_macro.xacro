<?xml version="1.0"?>
<robot name="piper_gripper" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="piper_gripper" params="
    parent
    prefix
    *origin">

    <!-- 夹爪基座：与官方 piper.xml 对齐，仅作为坐标系（link6 沿其 z 轴偏移 0.13503m）。
         夹爪本体外形已包含在 link6.stl 中，此处不再放置占位方块。 -->
    <joint name="${prefix}gripper_base_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}"/>
      <child link="${prefix}gripper_base_link" />
    </joint>
    <link name="${prefix}gripper_base_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.05" />
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
      </inertial>
    </link>

    <!-- 左指 (link7)：相对 link6 的变换 quat=(0,0,0.7071,0.7071) → rpy=(pi/2,0,pi)，
         沿指尖局部 -z 滑动，行程 0~0.035m（对应 piper.xml joint7）。 -->
    <joint name="${prefix}gripper_joint" type="prismatic">
      <origin xyz="0 0 0" rpy="${pi/2} 0 ${pi}" />
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}left_finger"/>
      <axis xyz="0 0 -1" />
      <limit lower="0" upper="0.035" effort="20" velocity="0.08" />
    </joint>
    <link name="${prefix}left_finger">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.02" />
        <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find piper_description)/meshes/link7.stl" />
        </geometry>
        <material name="finger_mat">
          <color rgba="0.9 0.7 0.1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find piper_description)/meshes/link7.stl" />
        </geometry>
      </collision>
    </link>

    <!-- 右指 (link8)：quat=(0,0,-0.7071,0.7071) → rpy=(-pi/2,0,pi)，沿局部 +z 滑动。
         mimic 左指、系数 -1（对应 piper.xml equality joint8 = -joint7），行程 -0.035~0。 -->
    <joint name="${prefix}right_finger_joint" type="prismatic">
      <origin xyz="0 0 0" rpy="-${pi/2} 0 ${pi}" />
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}right_finger"/>
      <axis xyz="0 0 1" />
      <limit lower="-0.035" upper="0" effort="20" velocity="0.08" />
      <mimic joint="${prefix}gripper_joint" multiplier="-1" offset="0" />
    </joint>
    <link name="${prefix}right_finger">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.02" />
        <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find piper_description)/meshes/link8.stl" />
        </geometry>
        <material name="finger_mat">
          <color rgba="0.9 0.7 0.1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find piper_description)/meshes/link8.stl" />
        </geometry>
      </collision>
    </link>

  </xacro:macro>
</robot>
