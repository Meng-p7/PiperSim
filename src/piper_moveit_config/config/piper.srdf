<?xml version="1.0" encoding="UTF-8"?>
<robot name="piper">
  <!-- GROUPS -->
  <group name="piper_arm">
    <joint name="joint1"/>
    <joint name="joint2"/>
    <joint name="joint3"/>
    <joint name="joint4"/>
    <joint name="joint5"/>
    <joint name="joint6"/>
  </group>
  <group name="piper_gripper">
    <joint name="joint7"/>
    <joint name="joint8"/>
  </group>
  <group name="piper_all">
    <chain base_link="base_link" tip_link="link8"/>
  </group>

  <!-- END EFFECTOR -->
  <end_effector name="gripper" parent_link="link6" group="piper_gripper"/>

  <!-- DISABLE COLLISIONS (simplified) -->
  <disable_collisions link1="base_link" link2="link1" reason="adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="adjacent"/>
  <disable_collisions link1="link5" link2="link6" reason="adjacent"/>
  <disable_collisions link1="link6" link2="link7" reason="adjacent"/>
  <disable_collisions link1="link6" link2="link8" reason="adjacent"/>

  <!-- VIRTUAL JOINTS -->
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>

  <!-- PASSIVE JOINTS -->
  <passive_joint name="joint8"/>
</robot>
