<?xml version="1.0" encoding="UTF-8"?>
<robot name="piper" xmlns:xacro="http://wiki.ros.org/xacro">
    <group name="manipulator">
        <chain base_link="base_link" tip_link="tool_0"/>
    </group>
    <group name="gripper">
        <chain base_link="gripper_base_link" tip_link="left_finger"/>
        <link name="right_finger"/>
    </group>

    <!-- home pose -->
    <group_state name="home" group="manipulator">
        <joint name="joint1" value="0"/>
        <joint name="joint2" value="0.01"/>
        <joint name="joint3" value="-0.01"/>
        <joint name="joint4" value="0"/>
        <joint name="joint5" value="0"/>
        <joint name="joint6" value="0"/>
    </group_state>
    <group_state name="forward" group="manipulator">
        <joint name="joint1" value="0"/>
        <joint name="joint2" value="1"/>
        <joint name="joint3" value="-0.85"/>
        <joint name="joint4" value="0"/>
        <joint name="joint5" value="0.85"/>
        <joint name="joint6" value="0"/>
    </group_state>
    <group_state name="open" group="gripper">
        <joint name="gripper_joint" value="0.035"/>
    </group_state>
    <group_state name="closed" group="gripper">
        <joint name="gripper_joint" value="0"/>
    </group_state>

    <!--END EFFECTOR-->
    <end_effector name="eff" parent_link="tool_0" group="gripper" parent_group="manipulator"/>

    <!--DISABLE COLLISIONS - 更完整的碰撞禁用配置 -->
    <!-- base_link 与其他 link 的碰撞 -->
    <disable_collisions link1="base_link" link2="link_1" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="table" reason="Never"/>
    <disable_collisions link1="base_link" link2="link_2" reason="Never"/>
    <disable_collisions link1="base_link" link2="link_3" reason="Never"/>
    <disable_collisions link1="base_link" link2="link_4" reason="Never"/>
    <disable_collisions link1="base_link" link2="link_5" reason="Never"/>
    <disable_collisions link1="base_link" link2="link_6" reason="Never"/>
    <disable_collisions link1="base_link" link2="gripper_base_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="left_finger" reason="Never"/>
    <disable_collisions link1="base_link" link2="right_finger" reason="Never"/>

    <disable_collisions link1="link_1" link2="link_2" reason="Adjacent"/>
    <disable_collisions link1="link_1" link2="link_3" reason="Never"/>
    <disable_collisions link1="link_1" link2="link_4" reason="Never"/>
    <disable_collisions link1="link_1" link2="link_5" reason="Never"/>
    <disable_collisions link1="link_1" link2="link_6" reason="Never"/>
    <disable_collisions link1="link_1" link2="table" reason="Never"/>
    <disable_collisions link1="link_1" link2="gripper_base_link" reason="Never"/>
    <disable_collisions link1="link_1" link2="left_finger" reason="Never"/>
    <disable_collisions link1="link_1" link2="right_finger" reason="Never"/>

    <disable_collisions link1="link_2" link2="link_3" reason="Adjacent"/>
    <disable_collisions link1="link_2" link2="link_4" reason="Never"/>
    <disable_collisions link1="link_2" link2="link_5" reason="Never"/>
    <disable_collisions link1="link_2" link2="link_6" reason="Never"/>
    <disable_collisions link1="link_2" link2="gripper_base_link" reason="Never"/>
    <disable_collisions link1="link_2" link2="left_finger" reason="Never"/>
    <disable_collisions link1="link_2" link2="right_finger" reason="Never"/>

    <disable_collisions link1="link_3" link2="link_4" reason="Adjacent"/>
    <disable_collisions link1="link_3" link2="link_5" reason="Never"/>
    <disable_collisions link1="link_3" link2="link_6" reason="Never"/>
    <disable_collisions link1="link_3" link2="gripper_base_link" reason="Never"/>
    <disable_collisions link1="link_3" link2="left_finger" reason="Never"/>
    <disable_collisions link1="link_3" link2="right_finger" reason="Never"/>

    <disable_collisions link1="link_4" link2="link_5" reason="Adjacent"/>
    <disable_collisions link1="link_4" link2="link_6" reason="Never"/>
    <disable_collisions link1="link_4" link2="gripper_base_link" reason="Never"/>
    <disable_collisions link1="link_4" link2="left_finger" reason="Never"/>
    <disable_collisions link1="link_4" link2="right_finger" reason="Never"/>

    <disable_collisions link1="link_5" link2="link_6" reason="Adjacent"/>
    <disable_collisions link1="link_5" link2="gripper_base_link" reason="Adjacent"/>
    <disable_collisions link1="link_5" link2="left_finger" reason="Never"/>
    <disable_collisions link1="link_5" link2="right_finger" reason="Never"/>

    <disable_collisions link1="link_6" link2="gripper_base_link" reason="Adjacent"/>
    <disable_collisions link1="link_6" link2="left_finger" reason="Default"/>
    <disable_collisions link1="link_6" link2="right_finger" reason="Default"/>

    <disable_collisions link1="gripper_base_link" link2="left_finger" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_link" link2="right_finger" reason="Adjacent"/>
    <disable_collisions link1="left_finger" link2="right_finger" reason="Default"/>

    <!-- Only the mounted base/first link may overlap the table model. Distal
         arm and gripper links deliberately keep table collision checking. -->
</robot>
