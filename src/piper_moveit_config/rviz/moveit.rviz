Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: base_link
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Value: true
      Description Topic: robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Value: false
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Value: true
      Robot Description: robot_description
      Planning Scene Topic: moveit/display_planning_scene
      Trajectory Topic: moveit/display_planned_path
    - Class: moveit_rviz_plugin/PlanningScene
      Name: PlanningScene
      Enabled: true
      Value: true
      Robot Description: robot_description
      Scene Topic: moveit/display_planning_scene
    - Class: moveit_rviz_plugin/Trajectory
      Name: Trajectory
      Enabled: true
      Value: true
      Robot Description: robot_description
      Path Topic: moveit/display_planned_path
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Views:
    - Class: rviz_default_plugins/Orbit
      Name: Orbit
      Enabled: true
      Value: true
      Target Frame: base_link
      Distance: 1.5
      Focal Point:
        X: 0
        Y: 0
        Z: 0.15
      Pitch: 0.5
      Yaw: 3.14
Window Geometry:
  Displays:
    collapsed: false
  MotionPlanning:
    collapsed: false
